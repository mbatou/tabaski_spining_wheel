# Spin mechanics — server-side, configurable per ATL guidance
SPIN_MAX_PER_DAY=2
SPIN_MAX_TOTAL=8

# Base segment weights (must be 5 comma-separated integers, summing arbitrarily — used as relative weights)
# Order: sac, tablier, eventail, gourde, lose
SPIN_WEIGHTS=25,10,10,5,50

# Inventory (stock for the whole campaign)
PRIZE_STOCK_SAC=1500
PRIZE_STOCK_TABLIER=600
PRIZE_STOCK_EVENTAIL=600
PRIZE_STOCK_GOURDE=500

# Daily caps per prize (default ≈ stock / 16 days, rounded up with headroom)
PRIZE_DAILY_CAP_SAC=100
PRIZE_DAILY_CAP_TABLIER=40
PRIZE_DAILY_CAP_EVENTAIL=40
PRIZE_DAILY_CAP_GOURDE=35

# Campaign timing (Africa/Dakar, ISO date)
CAMPAIGN_START=2026-05-11
CAMPAIGN_END=2026-05-25

# Cookie signing secret (any 32+ char random string)
COOKIE_SECRET=replace-me-with-a-32-char-random-string-please

# Upstash Redis (server-side spin state; leave blank to use in-memory dev fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supervisor panel — single shared password for the campaign chief and on-site supervisors.
# Required to access /supervisor. Set to a strong, freshly-generated value in production.
SUPERVISOR_PASSWORD=changeme

# Analytics (PostHog — leave blank to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
